<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelEditText"
    android:layout_width="match_parent"
    android:layout_height="380dp"
    android:background="@color/pe_surface_panel"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBackTextEdit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pe_back"
            app:tint="@color/pe_text_primary" />

        <TextView
            android:id="@+id/tvTextEditTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Edit Text • Typography"
            android:textColor="@color/pe_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnDoneTextEdit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_check"
            app:tint="@color/pe_accent_mint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B" />

    <!-- Text Input Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/etLayerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_box"
            android:hint="Enter text here..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="@color/pe_text_primary"
            android:textColorHint="@color/pe_text_secondary"
            android:textSize="14sp" />

        <!-- Color Swatch -->
        <View
            android:id="@+id/swatchTextColor"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_accent"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Toolbar: Alignment & Font Styles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <!-- Alignment Toggle Group (Left, Center, Right) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnTextAlignLeft"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_align_left"
                app:tint="@color/pe_text_secondary" />

            <ImageButton
                android:id="@+id/btnTextAlignCenter"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_align_center"
                app:tint="@color/pe_accent_mint" />

            <ImageButton
                android:id="@+id/btnTextAlignRight"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_align_right"
                app:tint="@color/pe_text_secondary" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#24304A" />

        <!-- Style Toggle Chips (Regular, Bold, Italic, Mono) -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Regular -->
                <TextView
                    android:id="@+id/chipStyleRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Regular"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />

                <!-- Bold -->
                <TextView
                    android:id="@+id/chipStyleBold"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Bold"
                    android:textColor="@color/pe_accent_mint"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Italic -->
                <TextView
                    android:id="@+id/chipStyleItalic"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Italic"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="italic" />

                <!-- Mono -->
                <TextView
                    android:id="@+id/chipStyleMono"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Mono"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp"
                    android:typeface="monospace" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Text Size Scrub Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Size:"
            android:textColor="@color/pe_text_secondary"
            android:textSize="11sp" />

        <glab.pixeleditor.view.ScrubRulerView
            android:id="@+id/rulerTextSize"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTextSizeDisplay"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_pill"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="48 pt"
            android:textColor="@color/pe_accent_mint"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Font Category Tabs (Favorites, All, Arabic & Urdu, Ds Grafix, etc.) -->
    <HorizontalScrollView
        android:id="@+id/hsvFontCategories"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="2dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutFontCategoryChips"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Fonts RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFontsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <!-- Empty State for Favorites or other empty categories -->
    <LinearLayout
        android:id="@+id/layoutEmptyFonts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivEmptyFontsIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:alpha="0.45"
            android:src="@drawable/ic_pe_star_outline"
            app:tint="@color/pe_text_secondary" />

        <TextView
            android:id="@+id/tvEmptyFontsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="No favorite fonts yet"
            android:textColor="@color/pe_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyFontsSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Tap the star icon next to any font to add it to your favorites."
            android:textColor="@color/pe_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
