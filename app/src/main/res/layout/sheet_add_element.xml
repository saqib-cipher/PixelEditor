<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheetAddElement"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pe_surface_panel"
    android:orientation="vertical">

    <!-- Top Categories Bar (Tabs) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/pe_surface_panel_elevated"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Tab 1: Shape -->
            <LinearLayout
                android:id="@+id/tabAddShape"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivTabShape"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tool_shape"
                    app:tint="@color/pe_accent_mint" />

                <TextView
                    android:id="@+id/tvTabShape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tab_shape"
                    android:textColor="@color/pe_accent_mint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab 2: Media -->
            <LinearLayout
                android:id="@+id/tabAddMedia"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivTabMedia"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_pe_media"
                    app:tint="@color/pe_icon_inactive" />

                <TextView
                    android:id="@+id/tvTabMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tab_media"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tab 3: Text -->
            <LinearLayout
                android:id="@+id/tabAddText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivTabText"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_pe_text"
                    app:tint="@color/pe_icon_inactive" />

                <TextView
                    android:id="@+id/tvTabText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tab_text"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tab 4: Elements -->
            <LinearLayout
                android:id="@+id/tabAddElements"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivTabElements"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_pe_element"
                    app:tint="@color/pe_icon_inactive" />

                <TextView
                    android:id="@+id/tvTabElements"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tab_element"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tab 5: Templates -->
            <LinearLayout
                android:id="@+id/tabAddTemplates"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivTabTemplates"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_pe_template"
                    app:tint="@color/pe_icon_inactive" />

                <TextView
                    android:id="@+id/tvTabTemplates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tab_template"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pe_border" />

    <!-- Center Grid + Right Action Rail (matching Image 1) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:orientation="horizontal">

        <!-- Grid Container for Shapes / Elements -->
        <FrameLayout
            android:id="@+id/containerTabContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp">

            <!-- Shapes Grid -->
            <GridLayout
                android:id="@+id/gridShapes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="6"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:rowOrderPreserved="false" />
        </FrameLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/pe_border" />

        <!-- Right Vertical Rail (Drawing, Vector, Text, Close) -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="@color/pe_surface_panel_elevated"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Freehand -->
            <LinearLayout
                android:id="@+id/btnRailFreehand"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_pe_brush"
                    app:tint="@color/pe_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Freehand"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Vector -->
            <LinearLayout
                android:id="@+id/btnRailVector"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_pe_pen"
                    app:tint="@color/pe_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Vector"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Text -->
            <LinearLayout
                android:id="@+id/btnRailText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_pe_text"
                    app:tint="@color/pe_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Text"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Close 'X' -->
            <ImageButton
                android:id="@+id/btnCloseAddSheet"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pe_close"
                app:tint="@color/pe_text_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Page Indicator Dots -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_pill_accent" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_pill_accent"
            android:alpha="0.4" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_pill_accent"
            android:alpha="0.4" />
    </LinearLayout>
</LinearLayout>
