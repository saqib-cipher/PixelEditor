<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_floating_top_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cloud AI Cutout Settings"
        android:textColor="@color/pe_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Select AI provider and configure your API key for studio-grade subject cutout."
        android:textColor="@color/pe_text_secondary"
        android:textSize="12sp" />

    <!-- Provider Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="AI Provider"
        android:textColor="@color/pe_accent_mint"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgBgProviders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <RadioButton
            android:id="@+id/rbProviderFreeAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Free Cloud AI (Automated)"
            android:textColor="@color/pe_text_primary"
            android:buttonTint="@color/pe_accent_mint" />

        <RadioButton
            android:id="@+id/rbProviderClipdrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clipdrop API (High-Accuracy Any Object)"
            android:textColor="@color/pe_text_primary"
            android:buttonTint="@color/pe_accent_mint" />

        <RadioButton
            android:id="@+id/rbProviderRemoveBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remove.bg API"
            android:textColor="@color/pe_text_primary"
            android:buttonTint="@color/pe_accent_mint" />

        <RadioButton
            android:id="@+id/rbProviderCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Custom Rembg Server (Self-Hosted)"
            android:textColor="@color/pe_text_primary"
            android:buttonTint="@color/pe_accent_mint" />
    </RadioGroup>

    <!-- API Key Input -->
    <LinearLayout
        android:id="@+id/layoutApiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Key"
            android:textColor="@color/pe_accent_mint"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBgApiKey"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_box"
            android:hint="Paste your API key here..."
            android:inputType="textPassword"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/pe_text_primary"
            android:textColorHint="@color/pe_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Custom Server URL Input -->
    <LinearLayout
        android:id="@+id/layoutCustomUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server URL"
            android:textColor="@color/pe_accent_mint"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBgCustomUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_box"
            android:hint="http://192.168.1.100:7000/api/remove"
            android:inputType="textUri"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/pe_text_primary"
            android:textColorHint="@color/pe_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/pe_text_secondary"
            app:strokeColor="#2C3852" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/pe_accent_mint"
            android:text="Save"
            android:textColor="#00382B"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
