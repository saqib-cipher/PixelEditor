<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelEffectControls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pe_surface_panel"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <!-- Top Bar: Back Arrow + Effects Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBackFromEffectControls"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pe_back"
            app:tint="@color/pe_text_primary" />

        <TextView
            android:id="@+id/tvEffectControlsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Effects"
            android:textColor="@color/pe_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetEffectParams"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Reset"
            android:textColor="@color/pe_accent_mint"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="@color/pe_border" />

    <!-- Main Content Area: Left Rail + Center Scrollable Effects List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="horizontal">

        <!-- 1. Left Vertical Sub-Rail (Back, Keyframe, Curve, More) -->
        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEffectBackRail"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pe_back"
                app:tint="@color/pe_text_secondary" />

            <ImageButton
                android:id="@+id/btnEffectKeyframe"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pe_diamond"
                app:tint="@color/pe_text_secondary" />

            <ImageButton
                android:id="@+id/btnEffectCurve"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pe_curve"
                app:tint="@color/pe_text_secondary" />

            <ImageButton
                android:id="@+id/btnEffectMore"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pe_more"
                app:tint="@color/pe_text_secondary" />
        </LinearLayout>

        <!-- 2. Center Dynamic Scrollable Container for Applied Effect Cards -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Vertical container for expandable effect cards -->
                <LinearLayout
                    android:id="@+id/containerAppliedEffects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Empty state label -->
                <TextView
                    android:id="@+id/tvEmptyAppliedEffects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="20dp"
                    android:paddingBottom="12dp"
                    android:text="No effects added yet"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- [ + Add Effect ] Pill Button matching Screenshots 1 & 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnAddEffectCard"
                    style="@style/Widget.PixelEditor.Card"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/pe_surface_panel_elevated"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="@color/pe_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_pe_add"
                            app:tint="@color/pe_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Add Effect"
                            android:textColor="@color/pe_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</LinearLayout>
