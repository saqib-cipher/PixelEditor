<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelMoveTransform"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pe_surface_panel"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <!-- Top Bar: Back Arrow + Move & Transform Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBackFromTransform"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pe_back"
            app:tint="@color/pe_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Move &amp; Transform"
            android:textColor="@color/pe_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="@color/pe_border" />

    <!-- Control Area: Left Rail + Center Touchpad + Right Mode Rail -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:orientation="horizontal">

        <!-- 1. Left Vertical Sub-Rail -->
        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnTransformBackRail"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pe_back"
                app:tint="@color/pe_text_secondary" />

            <ImageButton
                android:id="@+id/btnTransformKeyframe"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pe_diamond"
                app:tint="@color/pe_text_secondary" />

            <ImageButton
                android:id="@+id/btnTransformCurve"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pe_curve"
                app:tint="@color/pe_text_secondary" />

            <ImageButton
                android:id="@+id/btnTransformMore"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pe_more"
                app:tint="@color/pe_text_secondary" />
        </LinearLayout>

        <!-- 2. Center Touchpad Area -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <!-- Coordinate Pills Row: X | Y | Z / Value -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_accent"
                android:backgroundTint="@color/pe_surface_input"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvCoordLabel1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X: "
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCoordVal1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="540.00"
                    android:textColor="@color/pe_accent_mint"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCoordLabel2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Y: "
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCoordVal2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="960.00"
                    android:textColor="@color/pe_accent_mint"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCoordLabel3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="R: "
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvCoordVal3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0.0°"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Large Interactive Touchpad Surface -->
            <FrameLayout
                android:id="@+id/viewTransformPad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_transform_pad"
                android:clickable="true"
                android:focusable="true">

                <!-- Corner Bracket Visual Hints -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:text="┌"
                    android:textColor="#5500E5BC"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="4dp"
                    android:text="┐"
                    android:textColor="#5500E5BC"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp"
                    android:text="└"
                    android:textColor="#5500E5BC"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="4dp"
                    android:text="┘"
                    android:textColor="#5500E5BC"
                    android:textSize="16sp" />

                <!-- Center Prompt -->
                <TextView
                    android:id="@+id/tvTransformHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Swipe here to move layer"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="13sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- 3. Right Vertical Mode Selector Rail -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Position Mode -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModePosition"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardBackgroundColor="@color/pe_accent_mint"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/pe_accent_mint"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivModePosition"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_transform_translate"
                    app:tint="#00382B" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Rotation Mode -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModeRotate"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                app:cardBackgroundColor="@color/pe_surface_panel_elevated"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/pe_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivModeRotate"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_transform_rotate"
                    app:tint="@color/pe_text_secondary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Scale Mode -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModeScale"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                app:cardBackgroundColor="@color/pe_surface_panel_elevated"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/pe_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivModeScale"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_transform_scale"
                    app:tint="@color/pe_text_secondary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Skew Mode -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardModeSkew"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                app:cardBackgroundColor="@color/pe_surface_panel_elevated"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/pe_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/ivModeSkew"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_transform_skew"
                    app:tint="@color/pe_text_secondary" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
