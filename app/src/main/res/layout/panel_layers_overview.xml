<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelLayersOverview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pe_surface_panel"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <!-- Header Row: Layers count & quick + button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_pe_layers"
            app:tint="@color/pe_accent_mint" />

        <TextView
            android:id="@+id/tvOverviewLayersCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Layers (0)"
            android:textColor="@color/pe_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOverviewAddLayer"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="+ Add"
            android:textColor="@color/pe_bg_canvas_workspace"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/pe_accent_mint"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Multi-Selection & Grouping Toolbar (Alight Motion style) -->
    <HorizontalScrollView
        android:id="@+id/layoutOverviewMultiSelectActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverviewGroup"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Group"
                android:textColor="@color/pe_text_primary"
                android:textSize="11sp"
                app:backgroundTint="@color/pe_surface_elevated"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverviewMaskGroup"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Mask Group"
                android:textColor="@color/pe_accent_mint"
                android:textSize="11sp"
                app:backgroundTint="@color/pe_surface_elevated"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverviewExcludeGroup"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Exclude Group"
                android:textColor="@color/pe_text_primary"
                android:textSize="11sp"
                app:backgroundTint="@color/pe_surface_elevated"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverviewUngroup"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Ungroup"
                android:textColor="@color/pe_text_secondary"
                android:textSize="11sp"
                app:backgroundTint="@color/pe_surface_elevated"
                app:cornerRadius="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverviewClearSelect"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Clear"
                android:textColor="@color/pe_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="@color/pe_border" />

    <!-- Vertical scrollable layer cards (Alight Motion timeline stack style with drag reorder) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOverviewLayers"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
