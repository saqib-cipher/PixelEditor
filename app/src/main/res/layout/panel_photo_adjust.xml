<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelPhotoAdjust"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pe_surface_panel"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBackFromAdjust"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pe_back"
            app:tint="@color/pe_text_primary" />

        <TextView
            android:id="@+id/tvPhotoSizeHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Image Size"
            android:textColor="@color/pe_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetAdjustments"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Original"
            android:textColor="@color/pe_accent_mint"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@color/pe_border" />

    <!-- Width (X) in Pixels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Width (X)"
            android:textColor="@color/pe_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <glab.pixeleditor.view.ClampedSliderView
            android:id="@+id/sliderPhotoWidth"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPhotoWidthVal"
            android:layout_width="60dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center"
            android:text="300px"
            android:textColor="@color/pe_accent_mint"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Height (Y) in Pixels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Height (Y)"
            android:textColor="@color/pe_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <glab.pixeleditor.view.ClampedSliderView
            android:id="@+id/sliderPhotoHeight"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPhotoHeightVal"
            android:layout_width="60dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center"
            android:text="300px"
            android:textColor="@color/pe_accent_mint"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Controls Row: Lock Proportions Toggle + Quick Fit Presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPhotoAspectLock"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:checked="true"
            android:text="Lock Proportions"
            android:textColor="@color/pe_text_secondary"
            android:textSize="12sp"
            app:thumbTint="@color/pe_accent_mint"
            app:trackTint="#334155" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhotoMatchCanvas"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Fit Canvas"
            android:textColor="@color/pe_text_primary"
            android:textSize="11sp"
            app:backgroundTint="#243048"
            app:cornerRadius="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhotoSquare"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Square 1:1"
            android:textColor="@color/pe_text_primary"
            android:textSize="11sp"
            app:backgroundTint="#243048"
            app:cornerRadius="6dp" />
    </LinearLayout>
</LinearLayout>
