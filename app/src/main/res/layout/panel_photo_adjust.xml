<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelPhotoAdjust"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pe_surface_panel"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBackFromAdjust"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pe_back"
            app:tint="@color/pe_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/tool_adjust_photo"
            android:textColor="@color/pe_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetAdjustments"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Reset"
            android:textColor="@color/pe_accent_mint"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@color/pe_border" />

    <!-- Brightness Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="Brightness"
            android:textColor="@color/pe_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderBrightness"
            style="@style/Widget.PixelEditor.Slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="-100"
            android:valueTo="100"
            android:value="0" />

        <TextView
            android:id="@+id/tvBrightnessVal"
            android:layout_width="44dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/pe_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Contrast Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="Contrast"
            android:textColor="@color/pe_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderContrast"
            style="@style/Widget.PixelEditor.Slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="-100"
            android:valueTo="100"
            android:value="0" />

        <TextView
            android:id="@+id/tvContrastVal"
            android:layout_width="44dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/pe_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Saturation Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="Saturation"
            android:textColor="@color/pe_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSaturation"
            style="@style/Widget.PixelEditor.Slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:valueFrom="-100"
            android:valueTo="100"
            android:value="0" />

        <TextView
            android:id="@+id/tvSaturationVal"
            android:layout_width="44dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/pe_text_primary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
