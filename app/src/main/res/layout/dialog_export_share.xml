<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_floating_top_rounded"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle Indicator -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_indicator" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Export &amp; Share"
            android:textColor="@color/pe_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseExportDialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pe_close"
            app:tint="@color/pe_text_secondary" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="EXPORT FORMAT"
        android:textColor="@color/pe_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Format Selection Cards Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- PNG Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExportPng"
            style="@style/Widget.PixelEditor.Card"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/pe_surface_panel"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/pe_accent_mint"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFormatPngTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PNG"
                    android:textColor="@color/pe_accent_mint"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lossless &amp; Alpha"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- JPEG Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExportJpeg"
            style="@style/Widget.PixelEditor.Card"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/pe_surface_panel"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/pe_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFormatJpegTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JPEG"
                    android:textColor="@color/pe_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Compressed"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Project File Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardExportProject"
            style="@style/Widget.PixelEditor.Card"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/pe_surface_panel"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/pe_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFormatProjectTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Project"
                    android:textColor="@color/pe_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Backup File"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Resolution Selection Section -->
    <LinearLayout
        android:id="@+id/sectionResolution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESOLUTION &amp; QUALITY"
            android:textColor="@color/pe_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- 1x Original -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScale1x"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="1x Standard"
                android:textColor="@color/pe_accent_mint"
                android:textSize="11sp"
                app:strokeColor="@color/pe_accent_mint"
                app:strokeWidth="1.5dp" />

            <!-- 2x High Quality -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScale2x"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:text="2x High (2K)"
                android:textColor="@color/pe_text_secondary"
                android:textSize="11sp"
                app:strokeColor="@color/pe_border"
                app:strokeWidth="1dp" />

            <!-- 4x Ultra HD -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScale4x"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="4x Ultra (4K)"
                android:textColor="@color/pe_text_secondary"
                android:textSize="11sp"
                app:strokeColor="@color/pe_border"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- JPEG Quality Slider (Visible for JPEG format) -->
        <LinearLayout
            android:id="@+id/layoutJpegQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quality:"
                android:textColor="@color/pe_text_secondary"
                android:textSize="12sp" />

            <glab.pixeleditor.view.ClampedSliderView
                android:id="@+id/sliderJpegQuality"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                app:thumbColor="@color/pe_accent_mint"
                app:trackColorActive="@color/pe_accent_mint"
                app:trackColorInactive="@color/pe_border" />

            <TextView
                android:id="@+id/tvJpegQualityVal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="95%"
                android:textColor="@color/pe_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <!-- Save to Gallery Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveExportToGallery"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/pe_accent_mint"
            android:text="Save to Gallery"
            android:textColor="@color/pe_m3_on_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_pe_export"
            app:iconTint="@color/pe_m3_on_primary" />

        <!-- Share Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareExport"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Share File"
            android:textColor="@color/pe_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_pe_share"
            app:iconTint="@color/pe_text_primary"
            app:strokeColor="@color/pe_border"
            app:strokeWidth="1.5dp" />
    </LinearLayout>

</LinearLayout>
