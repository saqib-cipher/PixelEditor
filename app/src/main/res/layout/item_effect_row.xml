<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PixelEditor.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Thumbnail Preview -->
        <ImageView
            android:id="@+id/ivEffectThumbnail"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_panel_card"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_tool_effects" />

        <!-- Info Area -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEffectItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brightness / Contrast"
                android:textColor="@color/pe_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEffectItemDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Adjusts photo brightness and contrast"
                android:textColor="@color/pe_text_secondary"
                android:textSize="11sp" />

            <!-- Tags / Params chip -->
            <TextView
                android:id="@+id/tvEffectItemParamsSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Controls: Brightness, Contrast"
                android:textColor="@color/pe_accent_mint"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Arrow indicator -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_pe_redo"
            app:tint="@color/pe_text_tertiary" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
