<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLayerItem"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/pe_surface_panel_elevated"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pe_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/ivLayerTypeIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_tool_shape"
            app:tint="@color/pe_accent_mint" />

        <TextView
            android:id="@+id/tvSidebarLayerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Layer Name"
            android:textColor="@color/pe_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnLayerVisibility"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pe_visible"
            app:tint="@color/pe_text_secondary" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
