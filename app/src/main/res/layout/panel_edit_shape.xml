<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelEditShape"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pe_surface_panel"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <!-- Sub-panel Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBackFromEditShape"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_pe_back"
            app:tint="@color/pe_text_primary" />

        <TextView
            android:id="@+id/tvSubpanelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tool_edit_shape"
            android:textColor="@color/pe_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Change Shape Type Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeShapeType"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Change Shape"
            android:tooltipText="Change Shape"
            app:backgroundTint="@color/pe_surface_card"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_tool_shape"
            app:iconTint="@color/pe_accent_mint" />

        <!-- Reset Parameters to XML Default Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetShapeParams"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Reset Defaults"
            android:tooltipText="Reset Defaults"
            app:backgroundTint="@color/pe_surface_card"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_pe_undo"
            app:iconTint="@color/pe_text_secondary" />

        <!-- View / Modify Script CDATA Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShapeScriptCdata"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="View Script CDATA"
            android:tooltipText="View Script CDATA"
            app:backgroundTint="@color/pe_surface_card"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_pe_code"
            app:iconTint="@color/pe_accent_mint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:background="@color/pe_border" />

    <!-- Scrollable Container for Dynamic Shape Parameters (From XML params) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollShapeParams"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="2dp"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/containerShapeCustomParams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
