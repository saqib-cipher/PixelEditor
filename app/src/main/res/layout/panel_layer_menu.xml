<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panelLayerMenu"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pe_surface_panel"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- Quick Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickDuplicate"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:backgroundTint="@color/pe_surface_card"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_pe_duplicate"
            app:iconTint="@color/pe_text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickDelete"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:backgroundTint="@color/pe_surface_card"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_pe_delete"
            app:iconTint="@color/pe_accent_danger" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickForward"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:backgroundTint="@color/pe_surface_card"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_pe_undo"
            app:iconTint="@color/pe_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickBackward"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:backgroundTint="@color/pe_surface_card"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_pe_redo"
            app:iconTint="@color/pe_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickLock"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            app:backgroundTint="@color/pe_surface_card"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_pe_settings"
            app:iconTint="@color/pe_text_secondary" />
    </LinearLayout>

    <!-- Grid of Primary Editing Actions (Row 1) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Color & Fill -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnToolColorFill"
            style="@style/Widget.PixelEditor.Card"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tool_color"
                    app:tint="@color/pe_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tool_color_fill"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Border & Shadow -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnToolBorderShadow"
            style="@style/Widget.PixelEditor.Card"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tool_border"
                    app:tint="@color/pe_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tool_border_shadow"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Blending & Opacity -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnToolBlending"
            style="@style/Widget.PixelEditor.Card"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tool_blend"
                    app:tint="@color/pe_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tool_blending_opacity"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Grid of Primary Editing Actions (Row 2) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Move & Transform -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnToolTransform"
            style="@style/Widget.PixelEditor.Card"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tool_transform"
                    app:tint="@color/pe_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tool_move_transform"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Edit Shape / Adjust -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnToolEditShape"
            style="@style/Widget.PixelEditor.Card"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivEditShapeIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tool_shape"
                    app:tint="@color/pe_text_primary" />

                <TextView
                    android:id="@+id/tvEditShapeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tool_edit_shape"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Presets -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnToolPresets"
            style="@style/Widget.PixelEditor.Card"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tool_presets"
                    app:tint="@color/pe_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tool_presets"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Effects -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnToolEffects"
            style="@style/Widget.PixelEditor.Card"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tool_effects"
                    app:tint="@color/pe_accent_mint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tool_effects"
                    android:textColor="@color/pe_accent_mint"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
