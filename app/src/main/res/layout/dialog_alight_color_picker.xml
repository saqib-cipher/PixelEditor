<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.PixelEditor.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/pe_surface_panel"
    app:cardCornerRadius="16dp"
    app:cardElevation="16dp"
    app:strokeColor="@color/pe_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvColorDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose Color"
            android:textColor="@color/pe_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@color/pe_border" />

        <!-- Alight Color Picker View -->
        <glab.pixeleditor.ui.AlightColorPickerView
            android:id="@+id/dialogColorPickerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Action Buttons (Cancel / Apply) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogCancelColor"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Cancel"
                android:textColor="@color/pe_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogApplyColor"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="Apply"
                android:textColor="#0B0F19"
                android:textSize="13sp"
                app:backgroundTint="@color/pe_accent_mint"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
